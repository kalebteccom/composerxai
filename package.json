{
  "name": "composerxai-lint",
  "version": "0.1.0",
  "description": "Lints prose for AI tells. Typographic, structural, and dated-lexical rules, each with a source and a class.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "composerxai-lint": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/lint.mjs"
  },
  "files": [
    "src",
    "PRIOR_ART.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint:self": "node src/cli.mjs ."
  },
  "dependencies": {},
  "devDependencies": {}
}
